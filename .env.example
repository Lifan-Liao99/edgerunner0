# Copy to .env for local runs. `.env` is gitignored.

# Do not put service account key files here. This project uses keyless
# Application Default Credentials (ADC) from your user login.
#
# Recommended local setup:
# .\scripts\setup_local_user_adc.ps1 -ProjectId YOUR_PROJECT_ID

# Target spreadsheet used by the example tasks. Your logged-in Google user must
# have edit access to this spreadsheet.
GOOGLE_SHEET_ID=your_google_sheet_id

# Optional example of testing an authenticated API without Google Secret Manager.
# In config/tasks.toml set:
# api_secret_manager_address = "env:EXAMPLE_API_TOKEN"
EXAMPLE_API_TOKEN=replace_me
